# Server-side only. Never put real values in client code, Vite env, or git.
QLOO_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
UNSPLASH_ACCESS_KEY=

PORT=8787
HOST=127.0.0.1

# Hackathon keys are accepted at the hackathon gateway. Both values must match.
